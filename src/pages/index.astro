---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <div id="app" class="min-h-screen">
    <header class="topbar">
      <a class="brand" href="#today" aria-label="Sidequest home"><span class="brand-mark">s</span><span>sidequest</span></a>
      <div class="topbar-right"><span class="together-pill"><span class="presence-dot"></span><span id="space-name">Our space</span></span><button id="account-button" class="avatar-button" aria-label="Account" hidden>Y</button></div>
    </header>
    <div class="app-layout">
      <aside class="sidebar" aria-label="Main navigation">
        <nav class="nav-list">
          <button class="nav-item active" data-view="today"><span class="nav-icon">⌂</span>Today</button>
          <button class="nav-item" data-view="calendar"><span class="nav-icon">▦</span>Calendar</button>
          <button class="nav-item" data-view="tasks"><span class="nav-icon">✓</span>Tasks</button>
          <button class="nav-item" data-view="plans"><span class="nav-icon">◇</span>Our plans</button>
        </nav>
        <div class="sidebar-bottom"><p class="sidebar-note">Little by little,<br />a life together.</p><span class="sidebar-sparkle">✳</span></div>
      </aside>
      <main class="main-content">
        <div id="notice" class="notice" role="status" aria-live="polite"></div>
        <section id="view-today" class="view active-view"></section>
        <section id="view-calendar" class="view"></section>
        <section id="view-tasks" class="view"></section>
        <section id="view-plans" class="view"></section>
      </main>
    </div>
    <nav class="mobile-nav" aria-label="Main navigation">
      <button class="nav-item active" data-view="today"><span class="nav-icon">⌂</span><small>Today</small></button>
      <button class="nav-item" data-view="calendar"><span class="nav-icon">▦</span><small>Calendar</small></button>
      <button class="nav-item" data-view="tasks"><span class="nav-icon">✓</span><small>Tasks</small></button>
      <button class="nav-item" data-view="plans"><span class="nav-icon">◇</span><small>Plans</small></button>
    </nav>
    <button id="add-button" class="add-fab" aria-label="Create something" title="Create something">＋</button>
    <dialog id="auth-dialog" class="dialog"><form id="auth-form" class="dialog-card"><button class="close-button" type="button" data-close aria-label="Close">×</button><p class="eyebrow">A little space for two</p><h2 id="auth-title">Welcome to Sidequest</h2><p class="muted">Sign in or create an account to open your shared planner.</p><label>Email<input name="email" type="email" autocomplete="email" required placeholder="you@example.com" /></label><label>Password<input name="password" type="password" autocomplete="current-password" minlength="8" required placeholder="At least 8 characters" /></label><button class="button primary full" id="auth-submit">Sign in</button><button class="text-button" id="auth-toggle" type="button">New here? Create an account</button><p class="tiny muted">Email confirmation may be required before your first sign-in.</p></form></dialog>
    <dialog id="space-dialog" class="dialog"><form id="space-form" class="dialog-card"><button class="close-button" type="button" data-close aria-label="Close">×</button><p class="eyebrow">Your shared space</p><h2>Make room for your plans</h2><p class="muted">Your space is private. Only invited members can join; invitations are not set up yet.</p><label>Space name<input name="name" maxlength="80" value="Our space" required /></label><button class="button primary full">Create my space</button></form></dialog>
    <dialog id="item-dialog" class="dialog"><form id="item-form" class="dialog-card"><button class="close-button" type="button" data-close aria-label="Close">×</button><p class="eyebrow" id="form-kind">New item</p><h2 id="form-title">Add to your plans</h2><div id="form-fields"></div><button class="button primary full" id="save-item">Save</button></form></dialog>
    <dialog id="add-dialog" class="dialog add-dialog"><div class="dialog-card"><button class="close-button" type="button" data-close aria-label="Close">×</button><p class="eyebrow">Make it happen</p><h2>What would you like to add?</h2><div class="add-options"><button data-create="task"><span>✓</span><strong>Task</strong><small>One thing to do</small></button><button data-create="event"><span>▦</span><strong>Event</strong><small>Something on the calendar</small></button><button data-create="project"><span>↗</span><strong>Project</strong><small>A plan in motion</small></button><button data-create="goal"><span>◎</span><strong>Goal</strong><small>Something to grow toward</small></button></div></div></dialog>
  </div>
</Layout>
