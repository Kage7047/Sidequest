---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <div id="app" class="min-h-screen">
    <header class="topbar">
      <a class="brand" href="#today" aria-label="Sidequest home"><span class="brand-mark">s</span><span>sidequest</span></a>
      <div class="topbar-right"><span class="together-pill"><span class="presence-dot"></span><span id="space-name">Our space</span></span><button id="install-button" class="button secondary small" hidden>Add to home</button><button id="invite-button" class="button secondary small" hidden>Invite partner</button><button id="account-button" class="avatar-button" aria-label="Open profile" title="Profile" hidden>S</button></div>
    </header>
    <div class="app-layout">
      <aside class="sidebar" aria-label="Main navigation">
        <nav class="nav-list">
          <button class="nav-item active" data-view="today"><span class="nav-icon">⌂</span>Today</button>
          <button class="nav-item" data-view="calendar"><span class="nav-icon">▦</span>Calendar</button>
          <button class="nav-item" data-view="tasks"><span class="nav-icon">✓</span>Tasks</button>
          <button class="nav-item" data-view="lists"><span class="nav-icon">☷</span>Lists</button>
          <button class="nav-item" data-view="plans"><span class="nav-icon">◇</span>Our plans</button>
        </nav>
        <div class="sidebar-bottom"><p class="sidebar-note">Little by little,<br />a life together.</p><span class="sidebar-sparkle">✳</span></div>
      </aside>
      <main class="main-content">
        <div id="notice" class="notice" role="status" aria-live="polite"></div>
        <div id="offline-status" class="offline-status" hidden role="status"></div>
        <section id="view-today" class="view active-view"></section>
        <section id="view-calendar" class="view"></section>
        <section id="view-tasks" class="view"></section>
        <section id="view-lists" class="view"></section>
        <section id="view-plans" class="view"></section>
      </main>
    </div>
    <nav class="mobile-nav" aria-label="Main navigation">
      <button class="nav-item active" data-view="today"><span class="nav-icon">⌂</span><small>Today</small></button>
      <button class="nav-item" data-view="calendar"><span class="nav-icon">▦</span><small>Calendar</small></button>
      <button class="nav-item" data-view="tasks"><span class="nav-icon">✓</span><small>Tasks</small></button>
      <button class="nav-item" data-view="lists"><span class="nav-icon">☷</span><small>Lists</small></button>
      <button class="nav-item" data-view="plans"><span class="nav-icon">◇</span><small>Plans</small></button>
    </nav>
    <button id="add-button" class="add-fab" aria-label="Add a task" title="Add a task">＋</button>
    <dialog id="auth-dialog" class="dialog"><form id="auth-form" class="dialog-card"><button class="close-button" type="button" data-close aria-label="Close">×</button><p class="eyebrow">A little space for two</p><h2 id="auth-title">Welcome to Sidequest</h2><p class="muted" id="auth-description">Sign in or create an account to open your shared planner.</p><label>Email<input name="email" type="email" autocomplete="email" required placeholder="you@example.com" /></label><label>Password<input name="password" type="password" autocomplete="current-password" minlength="8" required placeholder="At least 8 characters" /></label><button class="button primary full" id="auth-submit">Sign in</button><button class="text-button" id="auth-toggle" type="button">New here? Create an account</button><p class="tiny muted">Email confirmation may be required before your first sign-in.</p></form></dialog>
    <dialog id="space-dialog" class="dialog"><form id="space-form" class="dialog-card"><button class="close-button" type="button" data-close aria-label="Close">×</button><p class="eyebrow">Your shared space</p><h2>Make room for your plans</h2><p class="muted">Create your private space, then invite your partner with a one-use link tied to their email address.</p><label>Space name<input name="name" maxlength="80" value="Our space" required /></label><button class="button primary full">Create my space</button></form></dialog>
    <dialog id="invite-dialog" class="dialog"><form id="invite-form" class="dialog-card"><button class="close-button" type="button" data-close aria-label="Close">×</button><p class="eyebrow">Bring your person in</p><h2>Invite your partner</h2><p class="muted">The link works once, expires after 7 days, and can only be accepted by an account with this email.</p><label>Partner’s email<input name="email" type="email" autocomplete="email" required placeholder="partner@example.com" /></label><button id="invite-submit" class="button primary full">Create invite link</button><div id="invite-result" class="invite-result" hidden><label>Share this link<input id="invite-link" type="url" readonly /></label><button id="copy-invite" class="button secondary full" type="button">Copy invite link</button><p class="tiny muted">They can create an account after opening the link. Share it privately.</p></div></form></dialog>
    <dialog id="profile-dialog" class="dialog"><form id="profile-form" class="dialog-card"><button class="close-button" type="button" data-close aria-label="Close">×</button><p class="eyebrow">A name that feels like you</p><h2>Your profile</h2><p class="muted">This is the name you and your partner will see on shared tasks.</p><label>Your name<input id="profile-name" name="display_name" maxlength="32" autocomplete="name" required placeholder="e.g. Ilya" /></label><button class="button primary full">Save name</button><button id="sign-out-button" class="text-button" type="button">Sign out</button></form></dialog>
    <dialog id="item-dialog" class="dialog"><form id="item-form" class="dialog-card"><button class="close-button" type="button" data-close aria-label="Close">×</button><p class="eyebrow" id="form-kind">New item</p><h2 id="form-title">Add to your plans</h2><div id="form-fields"></div><button class="button primary full" id="save-item">Save</button><button class="button danger full" id="delete-item" type="button" hidden>Delete</button></form></dialog>
    <dialog id="devices-dialog" class="dialog"><div class="dialog-card"><button class="close-button" type="button" data-close aria-label="Close">×</button><p class="eyebrow">A gentle nudge</p><h2>Reminder devices</h2><p class="muted">Reminders go only to the devices connected to your own account.</p><div id="device-list"></div></div></dialog>
    <dialog id="add-dialog" class="dialog add-dialog"><div class="dialog-card"><button class="close-button" type="button" data-close aria-label="Close">×</button><p class="eyebrow">Make it happen</p><h2>What would you like to add?</h2><div class="add-options"><button data-create="task"><span>✓</span><strong>Task</strong><small>One thing to do</small></button><button data-create="event"><span>▦</span><strong>Event</strong><small>Something on the calendar</small></button><button data-create="project"><span>↗</span><strong>Project</strong><small>A plan in motion</small></button><button data-create="goal"><span>◎</span><strong>Goal</strong><small>Something to grow toward</small></button></div></div></dialog>
    <dialog id="list-dialog" class="dialog"><form id="list-form" class="dialog-card"><button class="close-button" type="button" data-close aria-label="Close">×</button><p class="eyebrow">Keep it together</p><h2>Start a shared list</h2><label>List name<input name="title" maxlength="100" required placeholder="e.g. Sunday groceries" /></label><label>Kind<select name="list_type"><option value="grocery">Groceries</option><option value="packing">Packing</option><option value="custom">Something else</option></select></label><button class="button primary full">Create list</button></form></dialog>
    <dialog id="idea-dialog" class="dialog"><form id="idea-form" class="dialog-card"><button class="close-button" type="button" data-close aria-label="Close">×</button><p class="eyebrow">Save for a good day</p><h2>Add to our someday list</h2><label>Idea<input name="title" maxlength="200" required placeholder="e.g. Try the little bakery by the river" /></label><label>Kind<select name="kind"><option value="date">Date idea</option><option value="place">Place to visit</option><option value="activity">Something to try</option></select></label><label>Note (optional)<textarea name="details" maxlength="1000" placeholder="A little detail to remember"></textarea></label><button class="button primary full">Save idea</button></form></dialog>
    <dialog id="install-dialog" class="dialog"><div class="dialog-card"><button class="close-button" type="button" data-close aria-label="Close">×</button><p class="eyebrow">Take Sidequest with you</p><h2>Add to your home screen</h2><ol class="install-steps"><li><strong>iPhone:</strong> Open this page in Safari, tap Share, then <em>Add to Home Screen</em>.</li><li><strong>Android:</strong> Open this page in Chrome, tap ⋮, then <em>Install app</em> or <em>Add to Home screen</em>.</li></ol><p class="muted">This gives you an app icon and, on Android, quick actions from the icon. A live glanceable widget requires a native iPhone and Android app, which we can build as a separate step.</p></div></dialog>
  </div>
</Layout>
