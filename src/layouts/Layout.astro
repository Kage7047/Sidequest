---
import '../styles/global.css';
const { title = 'Sidequest — Your life, on the same page.' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F4ED" />
    <meta name="description" content="A calm shared planner for the life you are building together." />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="icon" href={`${base}icons/icon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon.png`} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/app.ts';
      if ('serviceWorker' in navigator && import.meta.env.PROD) {
        const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
        window.addEventListener('load', () => navigator.serviceWorker.register(`${base}sw.js`));
      }
    </script>
  </body>
</html>
