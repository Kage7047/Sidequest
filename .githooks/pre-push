#!/bin/sh
# Runs the same type check as CI before pushing, so a type error never reaches main
# (both past CI failures were type errors pushed unchecked). Enable once per clone:
#   git config core.hooksPath .githooks
# Skip in an emergency with: git push --no-verify
major=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)
if [ "$major" -lt 22 ]; then
  # nvm is a bash function and doesn't load in sh, so use an installed Node 22 directly.
  for dir in "$HOME"/.nvm/versions/node/v22*/bin; do [ -x "$dir/node" ] && PATH="$dir:$PATH"; done
fi
echo "pre-push: npm run check && npm test"
log=$(mktemp "${TMPDIR:-/tmp}/sidequest-check.XXXXXX") || exit 1
if npm run check --silent >"$log" 2>&1 && npm test --silent >>"$log" 2>&1; then rm -f "$log"; exit 0; fi
grep -E "error|Result|Node" "$log" | tail -20
echo "pre-push: type check failed (full log: $log)"
exit 1
