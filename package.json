{
  "name": "sidequest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-icon.mjs && node scripts/dev.mjs",
    "build": "node scripts/generate-icon.mjs && npm run tailwind:build && astro build --base /Sidequest",
    "preview": "astro preview",
    "check": "npm run tailwind:build && astro check",
    "tailwind:build": "tailwindcss -i src/styles/tailwind.input.css -o .generated/tailwind.css",
    "tailwind:watch": "tailwindcss -i src/styles/tailwind.input.css -o .generated/tailwind.css --watch",
    "astro:dev": "astro dev",
    "test": "vitest run src",
    "mock": "node scripts/mock-supabase.mjs",
    "e2e:build": "node scripts/generate-icon.mjs && npm run tailwind:build && PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 PUBLIC_SUPABASE_PUBLISHABLE_KEY=mock astro build --base /Sidequest --outDir .e2e-dist",
    "e2e": "npm run e2e:build && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@supabase/supabase-js": "2.57.4",
    "astro": "7.3.8",
    "gsap": "3.13.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.0",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.2",
    "vitest": "^3.2.4"
  }
}
