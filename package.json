{
  "name": "sidequest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-icon.mjs && node scripts/dev.mjs",
    "build": "node scripts/generate-icon.mjs && npm run tailwind:build && astro build --base /Sidequest",
    "preview": "astro preview",
    "check": "npm run tailwind:build && astro check",
    "tailwind:build": "tailwindcss -i src/styles/tailwind.input.css -o .generated/tailwind.css",
    "tailwind:watch": "tailwindcss -i src/styles/tailwind.input.css -o .generated/tailwind.css --watch",
    "astro:dev": "astro dev",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@tailwindcss/cli": "4.3.0",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.2",
    "vitest": "^3.2.4"
  }
}
